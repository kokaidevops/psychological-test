# Server
NODE_ENV=development
PORT=3000

# PostgreSQL
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=psych_test_db

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# HMAC (Odoo <-> Node.js)
HMAC_SECRET=change-this-very-long-random-secret

# Candidate JWT
JWT_SECRET=another-very-long-random-secret
JWT_EXPIRES_IN=4h
COOKIE_DOMAIN=localhost

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Security
TIMESTAMP_TOLERANCE_SECONDS=300        # 5 minutes
SESSION_GRACE_PERIOD_SECONDS=10        # for stop-session & validateSessionTime
STOP_SESSION_FLUSH_DELAY_MS=800        # delay before HGETALL to ensure last draft saved